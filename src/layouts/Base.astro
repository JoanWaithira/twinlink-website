---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemoDialog from '../components/DemoDialog.astro';
import VideoDialog from '../components/VideoDialog.astro';
import Intro from '../components/Intro.astro';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
// Preview builds (Netlify): hidden from search engines. Set PUBLIC_PREVIEW=true when building.
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';
// The logo intro plays on the home page only (on arrival and reload, see Intro.astro).
const isHome = (Astro.url.pathname.replace(/\/$/, '') || '/') === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <!-- Site icon: the twinlink.eu symbol (public/). -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f9f8" />
    {isHome && (
      <script is:inline>
        // Decide before the first paint whether the logo intro plays: on every arrival and every reload,
        // but not when coming back to the home page from another page of this site. Never with reduced motion.
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var reload = nav && nav.type === 'reload';
          var internal = !reload && document.referrer && new URL(document.referrer).origin === location.origin;
          if (!internal && !matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('intro'); history.scrollRestoration = 'manual'; scrollTo(0, 0); }
        } catch (e) {}
      </script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only">Skip to content</a>
    {isHome && <Intro />}
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <DemoDialog />
    <VideoDialog />
    <script>
      import '../lib/reveal';
      import '../lib/fx';
    </script>
  </body>
</html>

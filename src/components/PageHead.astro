---
// Top of an inner page: breadcrumb, eyebrow, title and intro, on a soft grid backdrop.
interface Props { eyebrow: string; title: string; intro?: string; crumbs?: { label: string; href: string }[] }
const { eyebrow, title, intro, crumbs = [] } = Astro.props;
---
<section class="phead">
  <div class="container-site">
    {crumbs.length > 0 && (
      <nav class="phead__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((c) => <Fragment><span aria-hidden="true">/</span><a href={c.href}>{c.label}</a></Fragment>)}
      </nav>
    )}
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="phead__title">{title}</h1>
    {intro && <p class="lede mt-4">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .phead { position: relative; padding-block: 2rem 2.5rem; overflow: hidden; background:
      radial-gradient(50% 80% at 85% 0%, rgb(34 211 122 / 0.12), transparent 70%),
      linear-gradient(rgb(13 45 99 / 0.04) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgb(13 45 99 / 0.04) 1px, transparent 1px) 0 0 / 32px 32px; }
  @media (min-width: 48rem) { .phead { padding-block: 3rem 3.5rem; } }
  .phead__crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; font-size: 0.875rem; color: var(--color-muted); }
  .phead__crumbs a { color: var(--color-muted); text-decoration: none; }
  .phead__crumbs a:hover { color: var(--color-navy); text-decoration: underline; }
  .phead__title { margin-top: 0.75rem; font-size: clamp(2.25rem, 4.6vw, 3.5rem); max-width: 22ch; }
</style>

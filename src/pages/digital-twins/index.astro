---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import GeohubBanner from '../../components/GeohubBanner.astro';
import { byType, geohub, typeOf } from '../../content/catalog';
const t = typeOf('twin');
const list = byType('twin');
---
<Base title={`${t.plural} | twinlink.eu`} description={t.intro}>
  <PageHead eyebrow={t.plural} title={t.intro} crumbs={[{ label: t.plural, href: t.href }]} />
  <section class="pb-16">
    <div class="container-site">
      <Catalog items={list} fixedType="twin" />
    </div>
  </section>
  <section class="pb-16">
    <div class="container-site">
      <p class="eyebrow">More digital twins, from research</p>
      <h2 class="mt-3 mb-6">All {geohub.entries.length} twins from the University of Twente Digital Twin Geohub</h2>
      <GeohubBanner showcase />
    </div>
  </section>
</Base>

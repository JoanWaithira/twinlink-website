---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ItemCard from '../components/ItemCard.astro';
// import TwinDashboard from '../components/TwinDashboard.astro'; // archived, see the twinlink OS comment below
import Search from '../components/Search.astro';
import { home as h } from '../content/site';
import { byTheme, byType, items, themes, types } from '../content/catalog';
import { Image } from 'astro:assets';
import { partnerLogo } from '../lib/partners';
// Real screenshots of the live demos (src/assets/demos/).
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/demos/*.png', { eager: true });
const shotFor = (name?: string) => name ? Object.entries(shots).find(([p]) => p.endsWith(`/${name}.png`))?.[1].default : undefined;
const demos = byType('twin').filter((d) => d.demo);
// Our own films (public/media/), shown as silent loops; click for the full video.
const filmOrder = ['data-space-and-data-labs', 'aadorp-energy-retrofit-dashboard', 'building-level-digital-twin', 'area-redesign-twin', 'wind-farm-twin', 'esdl-energy-system-editor'];
const films = items.filter((i) => i.clip).sort((a, b) => (filmOrder.indexOf(a.id) + 1 || 99) - (filmOrder.indexOf(b.id) + 1 || 99));
// Introduction video (YouTube, opens with sound): twinlink.eu | Digital Twins in Action: Almelo Pilot.
const HERO_VIDEO = 'JFxr2k6DeDQ';
---
<Base title={h.seo.title} description={h.seo.description}>
  <!-- Hero: the promise and a search, over the background film. -->
  <section class="hero">
    <!-- Background film: a promo montage of our own twins (see the films below), muted and looping.
         In the page itself (not added by script) so phones autoplay it; smaller file on small screens. -->
    <div class="hero__film" data-film aria-hidden="true">
      <video muted autoplay loop playsinline webkit-playsinline preload="auto" poster="/media/hero-montage.jpg" disablepictureinpicture disableremoteplayback tabindex="-1" data-film-video>
        <source src="/media/hero-montage.mp4" type="video/mp4" media="(min-width: 768px)" />
        <source src="/media/hero-montage-sm.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="hero__hud" aria-hidden="true"><i class="hero__corner hero__corner--tr"></i><i class="hero__corner hero__corner--br"></i></div>
    <div class="hero__filmbar container-site">
      <button type="button" class="hero__watch" data-watch={HERO_VIDEO} data-watch-title="twinlink.eu | Digital Twins in Action: Almelo Pilot">
        <span class="hero__watch-play"><Icon name="play" size={20} /></span>
        <span class="hero__watch-text"><strong>Watch the introduction video</strong><span>Digital twins in action: the Almelo pilot · with sound</span></span>
      </button>
      <button type="button" class="hero__filmbtn" data-film-toggle hidden aria-pressed="false">Pause background</button>
    </div>
    <div class="container-site hero__grid">
      <div class="hero__text">
        <p class="eyebrow">{h.hero.eyebrow}</p>
        <h1 class="hero__title" data-fx-words>{h.hero.headline}</h1>
        <p class="lede mt-5">{h.hero.body}</p>
        <Search label={h.hero.searchLabel} placeholder={h.hero.searchPlaceholder} />
        <div class="hero__actions">
          <a href={h.hero.primary.href} class="btn btn--green"><Icon name="play" size={18} />{h.hero.primary.label}</a>
          <a href={h.hero.secondary.href} class="btn btn--ghost">{h.hero.secondary.label}</a>
          <button type="button" class="btn btn--ghost hero__intro" data-watch={HERO_VIDEO} data-watch-title="twinlink.eu | Digital Twins in Action: Almelo Pilot"><Icon name="play" size={18} />Intro video</button>
        </div>
      </div>
    </div>
  </section>

  {/* ARCHIVED (Nov 2026): the twinlink OS section with the live 3D dashboard (src/components/TwinDashboard.astro,
      illustrative data). Taken off the page because the background film and "Twins in motion" now show the
      real twins. To bring it back, remove this comment and the one around the import at the top.
  <!-- twinlink OS: a live 3D twin with its data panels, in its own section (not over the video). -->
  <section class="section osdemo">
    <div class="container-site osdemo__grid">
      <div class="head" data-reveal>
        <p class="eyebrow">A twin at work</p>
        <h2>One screen for the whole town.</h2>
        <p class="lede mt-3">Buildings, energy, heat and traffic in one live model. Switch layers, follow the highlighted buildings, and see the numbers change as the town does.</p>
        <ul class="osdemo__points">
          <li><span>Energy</span>Use, solar and grid load, building by building.</li>
          <li><span>Heat</span>Hot streets and roofs, and where trees would help.</li>
          <li><span>Mobility</span>Traffic, bikes and buses through the same streets.</li>
        </ul>
        <a href="#try" class="btn btn--green mt-6"><Icon name="play" size={18} />Try a real twin</a>
      </div>
      <div class="osdemo__twin" data-reveal><TwinDashboard /></div>
    </div>
  </section>
  */}

  <!-- Twins in motion: our own films, playing as silent loops. -->
  <section class="section films fx-grid">
    <div class="container-site">
      <div class="head" data-reveal>
        <p class="eyebrow">Twins in motion</p>
        <h2>See them at work.</h2>
        <p class="lede mt-3">Short films of what we build: the Data Lab, twins of a village, a house and a wind farm, and the tools behind them.</p>
      </div>
      <div class="films__grid">
        {films.map((f) => (
          <article class="film" data-reveal>
            <button type="button" class="film__screen" data-watch-src={f.clip!.src} data-watch-poster={f.clip!.poster} data-watch-title={f.title} aria-label={`Watch the video: ${f.title}`}>
              <video class="film__loop" src={f.clip!.loop} poster={f.clip!.poster} muted loop playsinline preload="none" aria-hidden="true" data-film-loop></video>
              <span class="film__badge"><i></i>{f.id === 'data-space-and-data-labs' ? 'Data Space & Data Lab' : f.type === 'tool' ? 'Tool' : 'Digital twin'}</span>
              <span class="film__play"><Icon name="play" size={22} />Watch the full video</span>
            </button>
            <div class="film__body">
              <h3><a href={`/explore/${f.id}`}>{f.title}</a></h3>
              <p>{f.summary}</p>
              {f.features && <ul>{f.features.slice(0, 3).map((x) => <li>{x}</li>)}</ul>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Try it now: the live demos open in a window on the page. -->
  <section id="try" class="section try fx-grid">
    <div class="container-site">
      <div class="head" data-reveal>
        <p class="eyebrow">{h.try.eyebrow}</p>
        <h2>{h.try.headline}</h2>
        <p class="lede mt-3">{h.try.body}</p>
      </div>
      <div class="try__grid">
        {demos.map((d, i) => (
          <article class="tcard" data-reveal>
            <button type="button" class={`tcard__screen tcard__screen--${i}`} data-demo={d.demo} data-demo-title={d.title} aria-label={`Try ${d.title}`}>
              {shotFor(d.preview) && <Image src={shotFor(d.preview)!} alt="" widths={[480, 800, 1200]} sizes="(min-width: 48rem) 33vw, 100vw" class="tcard__shot" loading="lazy" />}
              <span class="tcard__sweep" aria-hidden="true"></span>
              <span class="tcard__live" aria-hidden="true"><i></i>Live</span>
              <span class="tcard__play"><Icon name="play" size={28} /></span>
            </button>
            <div class="tcard__body">
              <p class="tcard__meta">{d.status} · {d.scale === 'building' ? 'Building' : 'Neighbourhood'}</p>
              <h3><a href={`/explore/${d.id}`}>{d.title}</a></h3>
              <p class="text-[0.9375rem] text-muted mt-2">{d.summary}</p>
              <button type="button" class="btn btn--green btn--sm mt-4" data-demo={d.demo} data-demo-title={d.title}><Icon name="play" size={18} />Try it</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Explore by theme -->
  <section class="section themes">
    <div class="container-site">
      <div class="head" data-reveal>
        <p class="eyebrow">{h.themes.eyebrow}</p>
        <h2>{h.themes.headline}</h2>
      </div>
      <div class="themes__grid">
        {themes.map((t) => (
          <a href={`/themes/${t.id}`} class={`theme theme--${t.id}`} data-reveal>
            <span class="theme__icon"><Icon name={t.icon} size={26} /></span>
            <span class="theme__label">{t.label}</span>
            <span class="theme__q">“{t.question}”</span>
            <span class="theme__count"><span data-countup={byTheme(t.id).length}>{byTheme(t.id).length}</span> things to explore <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The shelves (categories) -->
  <section class="section shelves">
    <div class="container-site">
      <div class="head" data-reveal>
        <p class="eyebrow">{h.categories.eyebrow}</p>
        <h2>{h.categories.headline}</h2>
      </div>
      <div class="shelves__grid">
        {types.map((t) => (
          <a href={t.href} class={`shelf shelf--${t.id}`} data-reveal>
            <span class="shelf__n" data-countup={byType(t.id).length}>{byType(t.id).length}</span>
            <span class="shelf__icon"><Icon name={t.icon} size={24} /></span>
            <span class="shelf__label">{t.plural}</span>
            <span class="shelf__intro">{t.intro}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- From your town to Europe -->
  <section class="section levels">
    <div class="container-site">
      <div class="head" data-reveal>
        <p class="eyebrow">{h.ecosystem.eyebrow}</p>
        <h2>{h.ecosystem.headline}</h2>
        <p class="lede mt-3">{h.ecosystem.body}</p>
      </div>
      <ol class="levels__row" data-reveal>
        {h.ecosystem.levels.map((l, i) => (
          <li class={`level level--${i}`}>
            <span class="level__badge">{l.label}</span>
            <h3>{l.title}</h3>
            <p>{l.body}</p>
            {l.href && <a href={l.href} class="link-arrow mt-3">Have a look</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Where to begin (audiences) -->
  <section class="section">
    <div class="container-site">
      <div class="head" data-reveal>
        <p class="eyebrow">{h.audiences.eyebrow}</p>
        <h2>{h.audiences.headline}</h2>
      </div>
      <div class="doors">
        {h.audiences.items.map((a) => (
          <a href={a.href} class="door" data-reveal>
            <span class="door__title">{a.title}</span>
            <span class="door__body">{a.body}</span>
            <span class="link-arrow">{a.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners and news -->
  <section class="section pn">
    <div class="container-site pn__grid">
      <div data-reveal>
        <p class="eyebrow">{h.partners.eyebrow}</p>
        <h2>{h.partners.headline}</h2>
        <ul class="partners">
          {h.partners.items.map((p) => {
            const logo = partnerLogo(p.logo);
            const inner = <Fragment>{logo && <span class="partners__logo"><Image src={logo} alt="" height={56} /></span>}<strong>{p.name}</strong><span>{p.role}</span></Fragment>;
            return <li>{p.href ? <a href={p.href} target="_blank" rel="noopener">{inner}</a> : <div>{inner}</div>}</li>;
          })}
        </ul>
      </div>
      <div data-reveal>
        <p class="eyebrow">{h.news.eyebrow}</p>
        <h2>{h.news.headline}</h2>
        <ul class="news">
          {h.news.items.map((n) => (
            <li><span class="news__when">{n.when}</span><div><strong>{n.title}</strong><p>{n.body}</p>{n.href && <a class="news__more" href={n.href} target="_blank" rel="noopener">Read more<Icon name="arrow" size={16} /></a>}</div><span class="news__status">{n.status}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="section pt-0">
    <div class="container-site">
      <div class="closing" data-reveal>
        <div>
          <h2>{h.closing.headline}</h2>
          <p class="mt-3">{h.closing.body}</p>
        </div>
        <a href={h.closing.cta.href} class="btn btn--green">{h.closing.cta.label}<Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Film loops: play only while on screen (and never with reduced motion or data saver).
  {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData;
    const loops = document.querySelectorAll<HTMLVideoElement>('[data-film-loop]');
    if (!still) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      }), { threshold: 0.25 });
      loops.forEach((v) => io.observe(v));
    }
  }

  // Hero background film (the <video> is in the page). Stays still only with data saver. Phones that
  // block autoplay (iPhone Low Power Mode) start it on the first touch or scroll. A button pauses it.
  const film = document.querySelector<HTMLElement>('[data-film]');
  const v = document.querySelector<HTMLVideoElement>('[data-film-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-film-toggle]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (film && v) {
    const on = () => film.classList.add('is-on');
    v.addEventListener('playing', on);
    if (!v.paused) on();
    if (conn?.saveData) {
      v.pause();
    } else {
      v.muted = true;
      const tryPlay = () => { if (toggle?.getAttribute('aria-pressed') !== 'true') v.play().catch(() => {}); };
      tryPlay();
      for (const ev of ['touchstart', 'pointerdown', 'scroll', 'keydown']) addEventListener(ev, tryPlay, { once: true, passive: true });
      if (toggle) {
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const paused = toggle.getAttribute('aria-pressed') === 'true';
          toggle.setAttribute('aria-pressed', String(!paused));
          toggle.textContent = paused ? 'Pause background' : 'Play background';
          if (paused) v.play().catch(() => {}); else v.pause();
        });
      }
      // Pause the background while a full video plays in the window, resume after.
      document.addEventListener('video-dialog', (e) => {
        if (toggle?.getAttribute('aria-pressed') === 'true') return;
        if ((e as CustomEvent).detail === 'open') v.pause(); else v.play().catch(() => {});
      });
    }
  }
</script>

<style>
  .head { max-width: 44rem; }
  .head h2 { margin-top: 0.75rem; }

  /* Hero */
  .hero { position: relative; padding-block: 2.5rem 4rem; overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: -20% -10% auto auto; width: 60rem; height: 40rem; background: radial-gradient(closest-side, rgb(34 211 122 / 0.14), transparent); pointer-events: none; }
  .hero__film { position: absolute; inset: 0; overflow: hidden; pointer-events: none; background: url(/media/hero-montage.jpg) center / cover no-repeat, var(--color-navy-deep); }
  .hero__film :global(video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1s ease; }
  .hero__film.is-on :global(video) { opacity: 1; }
  /* The veil keeps the text readable on the left and lets the film show through on the right. */
  /* Dark hero: the film plays almost at full strength; a soft dark tint behind the white text keeps
     it readable. Stronger on the left (text), nearly clear on the right. */
  .hero { color: #fff; background: var(--color-navy-deep); }
  .hero__veil { position: absolute; inset: 0; pointer-events: none; background:
      linear-gradient(90deg, rgb(5 15 34 / 0.72) 0%, rgb(5 15 34 / 0.5) 38%, rgb(5 15 34 / 0.12) 62%, rgb(5 15 34 / 0) 100%),
      linear-gradient(180deg, rgb(5 15 34 / 0.25) 0%, transparent 25%, transparent 75%, rgb(5 15 34 / 0.45) 100%); }
  @media (max-width: 63.99rem) { .hero__veil { background: linear-gradient(180deg, rgb(5 15 34 / 0.55) 0%, rgb(5 15 34 / 0.35) 45%, rgb(5 15 34 / 0.6) 100%); } }
  .hero::before { display: none; }
  /* Tech overlay on the film: a faint grid, a slow scan line and viewfinder corners. */
  .hero__hud { position: absolute; inset: 0; pointer-events: none; overflow: hidden;
    background: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 56px 56px, linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 56px 56px;
    -webkit-mask: linear-gradient(90deg, transparent 30%, #000 70%); mask: linear-gradient(90deg, transparent 30%, #000 70%); }
  @media (max-width: 63.99rem) { .hero__hud { -webkit-mask: none; mask: none; opacity: 0.6; } }
  .hero__hud::after { content: ''; position: absolute; left: 0; right: 0; top: -20%; height: 18%; background: linear-gradient(180deg, transparent, rgb(56 189 248 / 0.10) 70%, rgb(125 211 252 / 0.45) 99%, transparent); animation: hero-scan 7s cubic-bezier(0.45, 0, 0.55, 1) infinite; }
  @keyframes hero-scan { 0% { transform: translateY(0); } 100% { transform: translateY(700%); } }
  .hero__corner { position: absolute; width: 26px; height: 26px; border: 2px solid rgb(125 211 252 / 0.7); }
  .hero__corner--tr { top: 1.25rem; right: 1.25rem; border-left: 0; border-bottom: 0; }
  .hero__corner--br { bottom: 5.5rem; right: 1.25rem; border-left: 0; border-top: 0; }
  @media (prefers-reduced-motion: reduce) { .hero__hud::after { display: none; } }
  .hero .eyebrow { color: var(--color-green-bright); }
  .hero__title { color: #fff; text-shadow: 0 2px 24px rgb(5 15 34 / 0.45); }
  .hero .lede { color: rgb(230 238 248 / 0.92); text-shadow: 0 1px 12px rgb(5 15 34 / 0.5); }
  .hero :global(.srch__label) { color: #fff; }
  .hero :global(.srch__box) { border-color: transparent; box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.6); }
  .hero .btn--ghost { background: rgb(255 255 255 / 0.12); border-color: rgb(255 255 255 / 0.45); color: #fff; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .hero .btn--ghost:hover { border-color: #fff; background: rgb(255 255 255 / 0.2); }
  .hero__filmbar { position: absolute; left: 0; right: 0; bottom: 1.25rem; display: flex; justify-content: flex-end; align-items: center; gap: 0.625rem; z-index: 2; pointer-events: none; }
  .hero__watch { pointer-events: auto; display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1.25rem 0.5rem 0.5rem; border: 0; border-radius: 999px; background: rgb(7 26 58 / 0.82); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: #fff; font: inherit; text-align: left; cursor: pointer; box-shadow: 0 18px 40px -18px rgb(7 26 58 / 0.8); transition: transform 250ms ease, background-color 250ms ease; }
  .hero__watch:hover { transform: translateY(-2px); background: rgb(7 26 58 / 0.95); }
  .hero__watch-play { position: relative; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: linear-gradient(135deg, var(--color-green), var(--color-teal)); }
  .hero__watch-play::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgb(34 211 122 / 0.6); animation: hero-ring 2.2s ease-out infinite; }
  @keyframes hero-ring { to { box-shadow: 0 0 0 14px rgb(34 211 122 / 0); } }
  .hero__watch-text { display: grid; line-height: 1.25; }
  .hero__watch-text strong { font-size: 0.9375rem; }
  .hero__watch-text span { font-size: 0.75rem; color: #b6c6dc; }
  .hero__filmbtn { pointer-events: auto; padding: 0.5rem 0.875rem; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.5); background: rgb(255 255 255 / 0.8); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font: inherit; font-size: 0.8125rem; font-weight: 600; color: var(--color-navy); cursor: pointer; }
  .hero__filmbtn:hover { border-color: var(--color-green); }
  .hero__filmbtn[hidden] { display: none; }
  /* On small screens the intro button sits in the hero actions instead. */
  .hero__intro { display: none; }
  @media (max-width: 63.99rem) { .hero__watch { display: none; } .hero__intro { display: inline-flex; } .hero__filmbar { bottom: 0.75rem; } }
  /* twinlink OS section */
  .osdemo { background: linear-gradient(180deg, var(--color-paper), var(--color-sky)); }
  .osdemo__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 64rem) { .osdemo__grid { grid-template-columns: 4fr 7fr; gap: 3rem; } }
  .osdemo .head h2 { margin-top: 0.75rem; }
  .osdemo__twin { min-width: 0; }
  .osdemo__points { display: grid; gap: 0.75rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .osdemo__points li { display: grid; gap: 0.125rem; padding: 0.75rem 1rem; border-radius: 1rem; background: var(--color-surface); border: 1px solid var(--color-line); font-size: 0.9375rem; color: var(--color-muted); }
  .osdemo__points span { font-weight: 700; color: var(--color-navy); }
  .hero__grid { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 64rem) { .hero__grid { grid-template-columns: minmax(0, 36rem); gap: 3rem; } .hero { padding-block: 3.5rem 6.5rem; } }
  .hero__title { margin-top: 1rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }

  /* Try it */
  .try { background: var(--color-navy-deep); color: #e6eef8; padding-top: 0; }
  .try .eyebrow { color: var(--color-green-bright); }
  .try h2 { color: #fff; }
  .try .lede { color: #b6c6dc; }
  .try__grid { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  @media (min-width: 48rem) { .try__grid { grid-template-columns: repeat(3, 1fr); } }
  .tcard { border-radius: 1.5rem; overflow: hidden; background: #0f2a55; border: 1px solid rgb(255 255 255 / 0.08); }
  .tcard__screen { position: relative; display: block; width: 100%; aspect-ratio: 16 / 10; border: 0; padding: 0; cursor: pointer; overflow: hidden; background: radial-gradient(80% 90% at 50% 100%, #134a86, #0a1f44); }
  .tcard__screen--1 { background: radial-gradient(80% 90% at 50% 100%, #0f6a63, #0a1f44); }
  .tcard__screen--2 { background: radial-gradient(80% 90% at 50% 100%, #0c7a4c, #0a1f44); }
  /* Real screenshot of each demo, with a slow camera-like pan and zoom (a different path per card),
     a light sweep and a live badge. */
  .tcard__shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform-origin: 30% 60%; animation: tc-pan-0 18s ease-in-out infinite alternate; transition: filter 400ms ease; }
  .tcard__screen--1 .tcard__shot { transform-origin: 40% 70%; animation-name: tc-pan-1; animation-duration: 22s; }

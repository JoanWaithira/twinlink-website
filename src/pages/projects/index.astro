---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import GeohubBanner from '../../components/GeohubBanner.astro';
import { byType, typeOf } from '../../content/catalog';
const t = typeOf('project');
const list = byType('project');
---
<Base title={`${t.plural} | twinlink.eu`} description={t.intro}>
  <PageHead eyebrow={t.plural} title={t.intro} crumbs={[{ label: t.plural, href: t.href }]} />
  <section class="pb-16">
    <div class="container-site">
      <GeohubBanner />
      <Catalog items={list} fixedType="project" />
    </div>
  </section>
</Base>

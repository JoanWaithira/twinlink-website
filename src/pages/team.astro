---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { team, teamPage as t } from '../content/team';
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/team/*.jpg', { eager: true });
const photoFor = (n: string) => Object.entries(photos).find(([p]) => p.endsWith(`/${n}.jpg`))?.[1].default;
---
<Base title={t.seo.title} description={t.seo.description}>
  <PageHead eyebrow={t.eyebrow} title={t.headline} intro={t.intro} crumbs={[{ label: 'Team', href: '/team' }]}>
    <nav class="tjump" aria-label="Team groups">
      {team.map((g) => <a href={`#${g.id}`}>{g.title}<span>{g.people.length}</span></a>)}
    </nav>
  </PageHead>

  {team.map((g, gi) => (
    <section id={g.id} class:list={['section tgroup', gi % 2 === 1 && 'tgroup--tint']}>
      <div class="container-site">
        <h2 class="tgroup__title" data-reveal>{g.title}</h2>
        <ul class="tgrid">
          {g.people.map((p) => (
            <li class="person" data-reveal>
              <div class="person__photo">
                {photoFor(p.photo) && <Image src={photoFor(p.photo)!} alt={p.name} widths={[320, 640]} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 6rem" loading="lazy" />}
              </div>
              <div class="person__body">
                <h3 class="person__name">{p.name}{p.note && <span class="person__note">{p.note}</span>}</h3>
                <p class="person__role">{p.role}</p>
                <p class="person__bio">{p.bio}</p>
                <div class="person__links">
                  <a href={`mailto:${p.email}`}>{p.email}</a>
                  <a href={p.linkedin} target="_blank" rel="noopener" aria-label={`${p.name} on LinkedIn`}><Icon name="linkedin" size={18} />LinkedIn</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section pt-0">
    <div class="container-site">
      <div class="join" data-reveal>
        <div>
          <h2>{t.join.headline}</h2>
          <p class="mt-3">{t.join.body}</p>
        </div>
        <a href={t.join.cta.href} class="btn btn--green">{t.join.cta.label}<Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tjump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .tjump a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; border-radius: 999px; border: 1px solid var(--color-line); background: var(--color-surface); font-size: 0.9375rem; font-weight: 600; text-decoration: none; transition: border-color 200ms ease; }
  .tjump a:hover { border-color: var(--color-green); }
  .tjump span { display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.35rem; border-radius: 999px; background: var(--color-mint); font-size: 0.75rem; color: #08744a; }
  .tgroup { padding-block: 3.5rem; }
  .tgroup--tint { background: var(--color-mint); }
  .tgroup__title { font-size: clamp(1.625rem, 2.6vw, 2.25rem); }
  .tgrid { display: grid; gap: 1.25rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  @media (min-width: 40rem) { .tgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .tgrid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 72rem) { .tgrid { grid-template-columns: repeat(4, 1fr); } }
  .person { display: flex; flex-direction: column; overflow: hidden; border-radius: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-line); transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 350ms ease; }
  .person:hover { transform: translateY(-5px); box-shadow: 0 26px 50px -30px rgb(13 45 99 / 0.55); }
  .person__photo { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: var(--color-sky); }
  .person__photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .person:hover .person__photo :global(img) { transform: scale(1.06); }
  .person__photo::after { content: ''; position: absolute; inset: auto 0 0; height: 4px; background: linear-gradient(90deg, var(--color-navy), var(--color-green)); transform: scaleX(0); transform-origin: left; transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .person:hover .person__photo::after { transform: scaleX(1); }
  .person__body { display: flex; flex: 1; flex-direction: column; gap: 0.375rem; padding: 1.25rem 1.375rem 1.375rem; }
  .person__name { font-size: 1.125rem; }
  .person__note { margin-left: 0.5rem; font-size: 0.75rem; font-weight: 500; color: var(--color-muted); white-space: nowrap; }
  .person__role { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #08744a; }
  .person__bio { margin-top: 0.25rem; font-size: 0.9375rem; color: var(--color-muted); }
  .person__links { display: grid; gap: 0.375rem; margin-top: auto; padding-top: 0.875rem; font-size: 0.875rem; }
  .person__links a { display: inline-flex; align-items: center; gap: 0.375rem; color: var(--color-navy); font-weight: 600; text-decoration: none; word-break: break-all; }
  .person__links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Phones: small photo beside the name and role, bio and links below. */
  @media (max-width: 39.99rem) {
    .tgrid { gap: 0.75rem; }
    .person { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); column-gap: 1rem; padding: 1rem; border-radius: 1.25rem; }
    .person__photo { grid-row: 1 / span 2; align-self: center; border-radius: 1rem; }
    .person__photo::after { display: none; }
    .person__body { display: contents; }
    .person__name { grid-column: 2; align-self: end; font-size: 1.0625rem; }
    .person__note { display: block; margin: 0.125rem 0 0; }
    .person__role { grid-column: 2; align-self: start; margin-top: 0.25rem; }
    .person__bio { grid-column: 1 / -1; margin-top: 0.875rem; }
    .person__links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; padding-top: 0.75rem; }
    .person__links a { word-break: normal; min-height: 2rem; }
  }
  .join { display: grid; gap: 1.5rem; align-items: center; padding: 2.5rem 2rem; border-radius: 2rem; background: linear-gradient(135deg, var(--color-navy), #134a8e 60%, #0e7f6a); color: #e6eef8; }
  @media (min-width: 48rem) { .join { grid-template-columns: 1fr auto; padding: 3.5rem; } }
  .join h2 { color: #fff; }
</style>

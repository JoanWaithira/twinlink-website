---
import Base from '../layouts/Base.astro';
---
<Base title="Not found | twinlink.eu" description="This page does not exist.">
  <section class="section">
    <div class="container-site">
      <p class="eyebrow">404</p>
      <h1 class="mt-3">This link leads nowhere.</h1>
      <p class="lede mt-4">The page may have moved. Everything we have is one click away.</p>
      <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn--primary" href="/explore">Explore everything</a><a class="btn btn--ghost" href="/">Home</a></div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { Image } from 'astro:assets';
import { about as a, home } from '../content/site';
import { partnerLogo } from '../lib/partners';
---
<Base title={a.seo.title} description={a.seo.description}>
  <PageHead eyebrow={a.eyebrow} title={a.headline} intro={a.body} crumbs={[{ label: 'About', href: '/about' }]} />
  <section class="section pt-6">
    <div class="container-site">
      <ol class="why">
        {a.why.map((w, i) => (
          <li class="why__item" data-reveal>
            <span class="why__n">0{i + 1}</span>
            <h2>{w.title}</h2>
            <p>{w.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section faqsec">
    <div class="container-site faq">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3">Asked often</h2>
      </div>
      <div class="faq__list">
        {a.faq.map((f) => (
          <details class="faq__item">
            <summary>{f.q}<span aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section" id="partners">
    <div class="container-site">
      <p class="eyebrow">{home.partners.eyebrow}</p>
      <h2 class="mt-3">{home.partners.headline}</h2>
      <ul class="partners">
        {home.partners.items.map((p) => {
          const logo = partnerLogo(p.logo);
          const inner = <Fragment>{logo && <span class="partners__logo"><Image src={logo} alt="" height={64} /></span>}<strong>{p.name}</strong><span>{p.role}</span></Fragment>;
          return <li data-reveal>{p.href ? <a href={p.href} target="_blank" rel="noopener">{inner}</a> : <div>{inner}</div>}</li>;
        })}
      </ul>
    </div>
  </section>
</Base>

<style>
  .why { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .why { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .why { grid-template-columns: repeat(4, 1fr); } }
  .why__item { padding: 1.75rem 1.5rem; border-radius: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-line); }
  .why__n { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.04em; color: var(--color-green); }
  .why__item h2 { margin-top: 0.5rem; font-size: 1.25rem; }
  .why__item p { margin-top: 0.5rem; color: var(--color-muted); font-size: 0.9375rem; }
  .faqsec { background: var(--color-mint); }
  .faq { display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .faq { grid-template-columns: 1fr 2fr; } }
  .faq__list { display: grid; gap: 0.75rem; }
  .faq__item { border-radius: 1.25rem; background: var(--color-surface); padding: 1.125rem 1.375rem; }
  .faq__item summary { display: flex; justify-content: space-between; gap: 1rem; font-weight: 700; cursor: pointer; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary span { color: var(--color-green); font-size: 1.5rem; line-height: 1; transition: transform 250ms ease; }
  .faq__item[open] summary span { transform: rotate(45deg); }
  .faq__item p { margin-top: 0.75rem; color: var(--color-muted); }
  .partners { display: grid; gap: 0.75rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .partners { grid-template-columns: repeat(3, 1fr); } }
  .partners li > * { display: grid; align-content: start; gap: 0.25rem; height: 100%; padding: 1.25rem; border-radius: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-line); color: inherit; text-decoration: none; transition: border-color 200ms ease, box-shadow 200ms ease; }
  .partners li > a:hover { border-color: var(--color-green); box-shadow: 0 14px 30px -22px rgb(13 45 99 / 0.45); }
  .partners__logo { display: flex; align-items: center; height: 4rem; margin-bottom: 0.75rem; }
  .partners__logo img { max-height: 100%; max-width: 13rem; width: auto; height: auto; object-fit: contain; }
  .partners span { font-size: 0.9375rem; color: var(--color-muted); }
</style>
